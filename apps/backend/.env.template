# --- Required everywhere -----------------------------------------------------
DATABASE_URL=

# Random strings of 32+ characters, e.g. `openssl rand -hex 32`.
# Production refuses to start without them.
JWT_SECRET=
COOKIE_SECRET=

# Comma-separated origins allowed to call the API. In production use the real
# storefront domain for STORE_CORS and the backend/admin domain for ADMIN_CORS;
# AUTH_CORS needs both.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000

# --- Production integrations (each is off while its variables are unset) ------

# Redis: events, workflows, cache, locks and sessions. Leave unset locally.
# REDIS_URL=redis://localhost:6379

# Stripe. Point a Stripe webhook at <backend>/hooks/payment/stripe_stripe and
# paste its signing secret here. The storefront needs NEXT_PUBLIC_STRIPE_KEY.
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# S3-compatible storage for product images (AWS S3, Cloudflare R2, ...).
# S3_FILE_URL is the public base URL the files are served from.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FILE_URL=
# S3_PREFIX=

# Resend, for order confirmation and password reset emails. The from address
# must be on a domain verified in Resend, e.g. "Store Name <orders@example.com>".
# Without a key, emails are logged to the console instead of sent.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# Optional: where customer replies go, e.g. support@example.com.
# RESEND_REPLY_TO_EMAIL=

# Where the store's own notifications go (e.g. new fitment requests).
# Defaults to RESEND_REPLY_TO_EMAIL.
# STORE_NOTIFICATION_EMAIL=

# --- Deployment ---------------------------------------------------------------

# Public URLs of this backend and of the storefront, used by the admin
# dashboard and in password reset emails.
# MEDUSA_BACKEND_URL=
# STOREFRONT_URL=
# "shared" (default) runs API and background jobs in one process.
# MEDUSA_WORKER_MODE=shared
# DISABLE_MEDUSA_ADMIN=false
